rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTenantUser(tenantId) {
      return isSignedIn() && exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid));
    }

    function getTenantUser(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data;
    }

    function isTenantAdmin(tenantId) {
      return isTenantUser(tenantId) && (getTenantUser(tenantId).role in ['admin', 'super_admin']);
    }

    function isSubscriptionActive(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.subscriptionStatus in ['active', 'trial'];
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Multi-tenant root structure: tenants/{tenantId}
    match /tenants/{tenantId} {
      // Tenant document read & writes
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        isTenantUser(tenantId)
      );
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        isTenantAdmin(tenantId)
      );

      // Subcollection: users/{userId}
      match /users/{userId} {
        allow read: if isTenantUser(tenantId);
        allow create: if isSignedIn() && (
          request.auth.uid == userId ||
          isTenantAdmin(tenantId)
        );
        allow update, delete: if isSignedIn() && (
          request.auth.uid == userId ||
          isTenantAdmin(tenantId)
        );
      }

      // Subcollection: categories/{categoryId}
      match /categories/{categoryId} {
        allow read: if isTenantUser(tenantId);
        allow write: if isTenantUser(tenantId) && isSubscriptionActive(tenantId);
      }

      // Subcollection: products/{productId}
      match /products/{productId} {
        allow read: if isTenantUser(tenantId);
        allow write: if isTenantUser(tenantId) && isSubscriptionActive(tenantId);
      }

      // Subcollection: sales/{saleId}
      match /sales/{saleId} {
        allow read: if isTenantUser(tenantId);
        allow create: if isTenantUser(tenantId) && isSubscriptionActive(tenantId);
        allow update, delete: if isTenantAdmin(tenantId);
      }

      // Subcollection: shifts/{shiftId}
      match /shifts/{shiftId} {
        allow read: if isTenantUser(tenantId);
        allow write: if isTenantUser(tenantId) && isSubscriptionActive(tenantId);
      }
    }

    // Multi-store backwards-compatible paths
    match /stores/{storeId}/{document=**} {
      allow read, write: if true;
    }
    match /products/{id} { allow read, write: if true; }
    match /sales/{id} { allow read, write: if true; }
    match /sale_items/{id} { allow read, write: if true; }
    match /users/{id} { allow read, write: if true; }
    match /store_config/{id} { allow read, write: if true; }
    match /categories/{id} { allow read, write: if true; }
    match /customers/{id} { allow read, write: if true; }
    match /customer_payments/{id} { allow read, write: if true; }
    match /requisitions/{id} { allow read, write: if true; }
  }
}
