rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // POS retail application: terminals on phones, tablets, and desktop computers
    // sync live inventory, sales, staff accounts, and store configs in real-time.
    match /products/{productId} {
      allow read, write: if true;
    }
    match /sales/{saleId} {
      allow read, write: if true;
    }
    match /sale_items/{itemId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /store_config/{configId} {
      allow read, write: if true;
    }
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    match /customers/{customerId} {
      allow read, write: if true;
    }
    match /customer_payments/{paymentId} {
      allow read, write: if true;
    }
  }
}
