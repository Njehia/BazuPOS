rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // =========================================================================
    // 1. UNIFIED BAZU POS MULTI-PLATFORM STORE-ISOLATED ARCHITECTURE
    // Structure:
    // users/{uid} -> { uid, email, role, storeId, createdAt, status }
    // stores/{storeId} -> { storeId, name, ownerUid, createdAt, status }
    //     products/{productId}
    //     sales/{saleId}
    //     inventory/{itemId}
    //     staff/{staffId}
    //     categories/{categoryId}
    //     shifts/{shiftId}
    // =========================================================================

    function hasUserProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStoreUser(storeId) {
      return isSignedIn() && (
        (hasUserProfile() && getUserProfile().storeId == storeId) ||
        (exists(/databases/$(database)/documents/stores/$(storeId)) && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid) ||
        exists(/databases/$(database)/documents/stores/$(storeId)/staff/$(request.auth.uid)) ||
        // Backwards compatibility with business/tenant mappings
        exists(/databases/$(database)/documents/businesses/$(storeId)/staff/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/tenants/$(storeId)/users/$(request.auth.uid))
      );
    }

    function isStoreAdmin(storeId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/stores/$(storeId)) && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid) ||
        (hasUserProfile() && getUserProfile().storeId == storeId && getUserProfile().role in ['admin', 'owner', 'super_admin']) ||
        (exists(/databases/$(database)/documents/stores/$(storeId)/staff/$(request.auth.uid)) && get(/databases/$(database)/documents/stores/$(storeId)/staff/$(request.auth.uid)).data.role in ['admin', 'owner', 'super_admin'])
      );
    }

    // Root Collection: users (Profile & storeId mapping)
    match /users/{uid} {
      // User can read their own profile, or store admin can read profiles of staff in their store
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (hasUserProfile() && isStoreAdmin(resource.data.storeId))
      );

      // User creates their own profile upon registration, or store admin adds staff
      allow create: if isSignedIn() && (
        request.auth.uid == uid ||
        (hasUserProfile() && isStoreAdmin(request.resource.data.storeId))
      );

      // User updates their own profile (e.g. name), or admin updates role/store mapping
      allow update: if isSignedIn() && (
        request.auth.uid == uid ||
        (hasUserProfile() && isStoreAdmin(resource.data.storeId))
      );

      // Only store admin can delete a user mapping
      allow delete: if isSignedIn() && hasUserProfile() && isStoreAdmin(resource.data.storeId);
    }

    // Root Collection: stores (Store metadata & subcollections)
    match /stores/{storeId} {
      // Store staff and owners can read store metadata
      allow read: if isStoreUser(storeId);

      // Web registration creates store document with authenticated user as owner
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;

      // Only store admin / owner can update store settings
      allow update: if isStoreAdmin(storeId);

      // Only owner can delete the store
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Subcollection: products (Catalog items)
      match /products/{productId} {
        allow read: if isStoreUser(storeId);
        allow create, update: if isStoreUser(storeId);
        allow delete: if isStoreAdmin(storeId);
      }

      // Subcollection: sales (Checkout transactions)
      match /sales/{saleId} {
        allow read: if isStoreUser(storeId);
        allow create: if isStoreUser(storeId);
        allow update, delete: if isStoreAdmin(storeId);
      }

      // Subcollection: inventory (Stock adjustments & control)
      match /inventory/{itemId} {
        allow read: if isStoreUser(storeId);
        allow write: if isStoreAdmin(storeId);
      }

      // Subcollection: staff (Staff credentials & terminal PINs)
      match /staff/{staffId} {
        allow read: if isStoreUser(storeId);
        allow create, update, delete: if isStoreAdmin(storeId) || (isSignedIn() && request.auth.uid == staffId);
      }

      // Subcollection: categories
      match /categories/{categoryId} {
        allow read: if isStoreUser(storeId);
        allow write: if isStoreUser(storeId);
      }

      // Subcollection: shifts (Cash drawer audits & reports)
      match /shifts/{shiftId} {
        allow read: if isStoreUser(storeId);
        allow write: if isStoreUser(storeId);
      }

      // Subcollection: customers & debt records
      match /customers/{customerId} {
        allow read, write: if isStoreUser(storeId);
      }

      match /customer_payments/{paymentId} {
        allow read, write: if isStoreUser(storeId);
      }

      match /requisitions/{reqId} {
        allow read, write: if isStoreUser(storeId);
      }

      match /store_config/{configId} {
        allow read: if isStoreUser(storeId);
        allow write: if isStoreAdmin(storeId);
      }

      match /{allStoreSubpaths=**} {
        allow read, write: if isStoreUser(storeId);
      }
    }

    // =========================================================================
    // 2. BACKWARDS-COMPATIBILITY: BUSINESSES & TENANTS ARCHITECTURE
    // =========================================================================
    function isBusinessOwner(businessId) {
      return isSignedIn() && (
        request.auth.uid == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid
      );
    }

    function isBusinessStaff(businessId) {
      return isSignedIn() && (
        isBusinessOwner(businessId) ||
        exists(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/businesses/$(businessId)/users/$(request.auth.uid))
      );
    }

    function isBusinessAdmin(businessId) {
      return isSignedIn() && (
        isBusinessOwner(businessId) ||
        (exists(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/businesses/$(businessId)/staff/$(request.auth.uid)).data.role in ['owner', 'admin', 'super_admin', 'manager'])
      );
    }

    match /businesses/{businessId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBusinessStaff(businessId));
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isBusinessAdmin(businessId));
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /staff/{staffId} {
        allow read: if isBusinessStaff(businessId);
        allow write: if isBusinessAdmin(businessId) || (isSignedIn() && request.auth.uid == staffId);
      }

      match /users/{userId} {
        allow read: if isBusinessStaff(businessId);
        allow write: if isBusinessAdmin(businessId) || (isSignedIn() && request.auth.uid == userId);
      }

      match /products/{productId} {
        allow read, write: if isBusinessStaff(businessId);
      }

      match /sales/{saleId} {
        allow read, create: if isBusinessStaff(businessId);
        allow update, delete: if isBusinessAdmin(businessId);
      }

      match /categories/{categoryId} {
        allow read, write: if isBusinessStaff(businessId);
      }

      match /shifts/{shiftId} {
        allow read, write: if isBusinessStaff(businessId);
      }

      match /customers/{customerId} {
        allow read, write: if isBusinessStaff(businessId);
      }
    }

    match /tenants/{tenantId} {
      allow read, write: if isSignedIn();
      match /{allTenantSubpaths=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
