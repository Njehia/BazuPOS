{
  "entities": {
    "tenants": {
      "title": "Tenant",
      "description": "Multi-tenant merchant store organization",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "description": "Business or merchant name" },
        "ownerUid": { "type": "string", "description": "Firebase Auth UID of merchant store owner" },
        "subscriptionStatus": { "type": "string", "description": "Subscription state active, trial, past_due, cancelled" },
        "plan": { "type": "string", "description": "Pricing tier e.g. starter, pro, enterprise" },
        "createdAt": { "type": "string", "description": "ISO creation timestamp" }
      },
      "required": ["businessName", "ownerUid", "subscriptionStatus", "plan", "createdAt"]
    },
    "tenant_users": {
      "title": "TenantUser",
      "description": "User associated with a specific tenant business",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Staff or merchant email address" },
        "role": { "type": "string", "description": "Role: super_admin, admin, manager, cashier" },
        "name": { "type": "string", "description": "Full staff name" },
        "pinHash": { "type": "string", "description": "Quick terminal login PIN hash" }
      },
      "required": ["email", "role", "name", "pinHash"]
    },
    "tenant_categories": {
      "title": "TenantCategory",
      "description": "Product category for organizing retail inventory",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Category name" },
        "icon": { "type": "string", "description": "Category emoji or icon" },
        "description": { "type": "string", "description": "Description of items in this category" },
        "createdAt": { "type": "string", "description": "ISO creation timestamp" }
      },
      "required": ["name"]
    },
    "tenant_products": {
      "title": "TenantProduct",
      "description": "Catalog product for this specific merchant tenant",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Product display name" },
        "category": { "type": "string", "description": "Product category" },
        "price": { "type": "number", "description": "Selling price in KES" },
        "costPrice": { "type": "number", "description": "Wholesale cost price" },
        "stockQuantity": { "type": "number", "description": "Current on-hand inventory count" },
        "barcode": { "type": "string", "description": "Barcode or SKU for scanning" },
        "quickKey": { "type": "boolean", "description": "Whether starred in the quick keys grid" }
      },
      "required": ["name", "category", "price", "stockQuantity"]
    },
    "tenant_sales": {
      "title": "TenantSale",
      "description": "Point-of-Sale completed transaction",
      "type": "object",
      "properties": {
        "items": { "type": "array", "description": "Itemized line items purchased" },
        "totalAmount": { "type": "number", "description": "Total order amount in KES" },
        "paymentMethod": { "type": "string", "description": "Payment tender CASH, MPESA, CARD, SPLIT, DEBT" },
        "referenceCode": { "type": "string", "description": "Receipt reference or M-Pesa transaction code" },
        "cashierId": { "type": "string", "description": "ID or UID of the cashier who handled the transaction" },
        "createdAt": { "type": "string", "description": "ISO transaction timestamp" }
      },
      "required": ["items", "totalAmount", "paymentMethod", "referenceCode", "cashierId", "createdAt"]
    },
    "tenant_shifts": {
      "title": "TenantShift",
      "description": "Cashier shift record and drawer reconciliation",
      "type": "object",
      "properties": {
        "cashierId": { "type": "string", "description": "Cashier identifier" },
        "openTime": { "type": "string", "description": "Shift opening timestamp" },
        "closeTime": { "type": "string", "description": "Shift closing timestamp" },
        "openingCash": { "type": "number", "description": "Starting cash float" },
        "closingCash": { "type": "number", "description": "Closing cash drawer count" },
        "totalSales": { "type": "number", "description": "Total sales accumulated during this shift" }
      },
      "required": ["cashierId", "openTime", "openingCash"]
    },
    "stores": {
      "title": "Store",
      "description": "Isolated store entity for multi-platform tenant architecture",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "description": "Predictable unique store identifier" },
        "name": { "type": "string", "description": "Store display name" },
        "ownerUid": { "type": "string", "description": "Firebase Auth UID of store administrator" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "status": { "type": "string", "description": "Store lifecycle status e.g. active, suspended" }
      },
      "required": ["storeId", "name", "ownerUid", "createdAt", "status"]
    },
    "users": {
      "title": "UserProfile",
      "description": "Global user account mapped to store and role",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "role": { "type": "string", "description": "admin, staff, cashier, or manager" },
        "storeId": { "type": "string", "description": "Associated store identifier" },
        "createdAt": { "type": "string", "description": "ISO creation timestamp" },
        "status": { "type": "string", "description": "active or suspended" }
      },
      "required": ["uid", "email", "role", "storeId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "users",
      "description": "User profile with role and storeId mapping"
    },
    "/stores/{storeId}": {
      "schema": "stores",
      "description": "Store metadata with ownerUid and status"
    },
    "/stores/{storeId}/products/{productId}": {
      "schema": "tenant_products",
      "description": "Store-isolated product catalog"
    },
    "/stores/{storeId}/sales/{saleId}": {
      "schema": "tenant_sales",
      "description": "Store-isolated completed transactions"
    },
    "/stores/{storeId}/inventory/{itemId}": {
      "schema": "tenant_products",
      "description": "Store-isolated stock inventory control"
    },
    "/stores/{storeId}/staff/{staffId}": {
      "schema": "tenant_users",
      "description": "Store-isolated staff and cashier accounts"
    },
    "/tenants/{tenantId}": {
      "schema": "tenants",
      "description": "Root tenant organization document"
    },
    "/tenants/{tenantId}/users/{userId}": {
      "schema": "tenant_users",
      "description": "Tenant staff accounts and permissions"
    },
    "/tenants/{tenantId}/categories/{categoryId}": {
      "schema": "tenant_categories",
      "description": "Tenant isolated product categories"
    },
    "/tenants/{tenantId}/products/{productId}": {
      "schema": "tenant_products",
      "description": "Tenant isolated inventory catalog"
    },
    "/tenants/{tenantId}/sales/{saleId}": {
      "schema": "tenant_sales",
      "description": "Tenant isolated completed transactions"
    },
    "/tenants/{tenantId}/shifts/{shiftId}": {
      "schema": "tenant_shifts",
      "description": "Tenant cashier shift records and X/Z reports"
    },
    "/businesses/{businessId}": {
      "schema": "tenants",
      "description": "Root business document with name and ownerUid"
    },
    "/businesses/{businessId}/staff/{staffId}": {
      "schema": "tenant_users",
      "description": "Business staff and cashier permissions"
    },
    "/businesses/{businessId}/products/{productId}": {
      "schema": "tenant_products",
      "description": "Business-isolated product inventory"
    },
    "/businesses/{businessId}/sales/{saleId}": {
      "schema": "tenant_sales",
      "description": "Business-isolated sales transactions"
    }
  }
}
